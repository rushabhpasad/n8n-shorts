{
  "name": "Bright Beasts \u2014 Daily Shorts",
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "errorWorkflow": "1VcriNGIB4vF6A0u"
  },
  "nodes": [
    {
      "id": "trigger_manual",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        240,
        300
      ],
      "parameters": {}
    },
    {
      "id": "trigger_cron",
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        240,
        500
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 12 * * *"
            }
          ]
        }
      }
    },
    {
      "id": "get_next",
      "name": "Get next word",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        460,
        400
      ],
      "parameters": {
        "method": "GET",
        "url": "http://host.docker.internal:7860/bright-beasts/state/next",
        "options": {
          "timeout": 10000
        }
      }
    },
    {
      "id": "if_pending",
      "name": "Has pending word?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        680,
        400
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond_id_exists",
              "leftValue": "={{ $('Get next word').item.json?.id }}",
              "rightValue": "",
              "operator": {
                "type": "number",
                "operation": "exists",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "do_script",
      "name": "Generate script",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        900,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:7860/bright-beasts/script",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={\"word_id\": {{ $('Get next word').item.json.id }}}",
        "options": {
          "timeout": 360000
        }
      }
    },
    {
      "id": "do_voice",
      "name": "Generate voice",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1120,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:7860/bright-beasts/voice",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={\"word_id\": {{ $('Get next word').item.json.id }}}",
        "options": {
          "timeout": 60000
        }
      }
    },
    {
      "id": "do_image",
      "name": "Generate images",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1340,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:7860/bright-beasts/image",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={\"word_id\": {{ $('Get next word').item.json.id }}}",
        "options": {
          "timeout": 7200000
        }
      }
    },
    {
      "id": "do_assemble",
      "name": "Assemble video",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1560,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:7860/bright-beasts/assemble",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={\"word_id\": {{ $('Get next word').item.json.id }}}",
        "options": {
          "timeout": 120000
        }
      }
    },
    {
      "id": "do_upload",
      "name": "Upload to YouTube",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1780,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:7860/bright-beasts/upload",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={\"word_id\": {{ $('Get next word').item.json.id }}}",
        "options": {
          "timeout": 600000
        }
      }
    },
    {
      "id": "do_comment",
      "name": "Post comment",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2000,
        520
      ],
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:7860/bright-beasts/comment",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={\"video_id\": {{ JSON.stringify($('Upload to YouTube').item.json.video_id) }} }",
        "options": {
          "timeout": 30000
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "format_success",
      "name": "Format success",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2000,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const up = $input.first().json || {};\nconst word = ($('Get next word').item && $('Get next word').item.json) || {};\nconst esc = (s) => String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nconst title = esc(word.word || word.title || (\"word \" + (up.word_id ?? \"\")));\nreturn [{ json: { text: `\u2705 Bright Beasts \u2014 uploaded \"${title}\"${up.url ? \"\\n\" + up.url : \"\"}` } }];"
      }
    },
    {
      "id": "notify_telegram",
      "name": "Notify success",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        2220,
        200
      ],
      "parameters": {
        "resource": "message",
        "operation": "sendMessage",
        "chatId": "3819613",
        "text": "={{ $json.text }}",
        "additionalFields": {
          "appendAttribution": false,
          "parse_mode": "HTML"
        }
      },
      "credentials": {
        "telegramApi": {
          "id": "YiSf07hq0zNuBX1W",
          "name": "Telegram account"
        }
      }
    },
    {
      "id": "notify_slack",
      "name": "Notify success (Slack)",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.4,
      "position": [
        2220,
        400
      ],
      "parameters": {
        "resource": "message",
        "operation": "post",
        "authentication": "accessToken",
        "select": "channel",
        "channelId": {
          "__rl": true,
          "mode": "id",
          "value": "C0BBAB1G588"
        },
        "text": "={{ $json.text }}",
        "messageType": "text"
      },
      "credentials": {
        "slackApi": {
          "id": "rMjfnad1hdCf097y",
          "name": "Slack account"
        }
      }
    }
  ],
  "connections": {
    "Manual Trigger": {
      "main": [
        [
          {
            "node": "Get next word",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Schedule Trigger": {
      "main": [
        [
          {
            "node": "Get next word",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get next word": {
      "main": [
        [
          {
            "node": "Has pending word?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Has pending word?": {
      "main": [
        [
          {
            "node": "Generate script",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    },
    "Generate script": {
      "main": [
        [
          {
            "node": "Generate voice",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Generate voice": {
      "main": [
        [
          {
            "node": "Generate images",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Generate images": {
      "main": [
        [
          {
            "node": "Assemble video",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Assemble video": {
      "main": [
        [
          {
            "node": "Upload to YouTube",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Upload to YouTube": {
      "main": [
        [
          {
            "node": "Post comment",
            "type": "main",
            "index": 0
          },
          {
            "node": "Format success",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Format success": {
      "main": [
        [
          {
            "node": "Notify success",
            "type": "main",
            "index": 0
          },
          {
            "node": "Notify success (Slack)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
