# api/.env — runtime config for the FastAPI service (pydantic-settings).
# Copy to api/.env and edit. All keys are OPTIONAL; defaults live in config.py.
# Field names map case-insensitively to env keys (hf_token -> HF_TOKEN).
# NEVER commit api/.env (it is gitignored) — this .example file is the template.

# --- API server ---
# HOST=0.0.0.0
# PORT=7860

# --- Ollama (script LLM) ---
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=gemma4:latest
# OLLAMA_TIMEOUT_S=300

# --- Image backend ---
# "space" = hosted Z-Image-Turbo ZeroGPU Space (default), per-image fallback to
# local mflux on any failure. "mflux" = local MLX generation only.
# IMAGE_BACKEND=space
# ZIMAGE_SPACE_URL=https://mrfakename-z-image-turbo.hf.space
# ZIMAGE_SPACE_TIMEOUT_S=180

# HF token for the hosted Space. Passed to gradio_client as token=, which bills
# ZeroGPU usage to YOUR account quota (free 5 min/day, PRO 40 min/day) instead
# of the anonymous per-IP pool (2 min/day). The raw REST API does NOT attribute
# to the account — use of gradio_client is required. ~10-15 s/image; mflux
# absorbs the tail once quota runs low. Get one at https://huggingface.co/settings/tokens
# HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- mflux (local image gen, Apple Silicon) ---
# MFLUX_MODEL=z-image-turbo
# MFLUX_QUANTIZE=8
# MFLUX_STEPS=8
# MFLUX_GUIDANCE=1.0
# MFLUX_SCHEDULER=flow_match_euler_discrete
# MFLUX_WIDTH=768
# MFLUX_HEIGHT=1344
# MFLUX_SEED_BASE=42
# MFLUX_CACHE_LIMIT_BYTES=1073741824

# --- Piper TTS ---
# PIPER_LENGTH_SCALE=1.1
# PIPER_VOICES_DIR=~/n8n-shorts/assets/piper

# --- Captions / outro ---
# CAPTION_LEAD_S=0.0
# OUTRO_PAUSE_S=0.25
# OUTRO_CTA=...   # empty string disables the spoken CTA and the outro card

# --- Storage / secrets (per-channel files live under these dirs) ---
# DATA_DIR=~/n8n-shorts/output
# DB_PATH=~/n8n-shorts/state.db
# SECRETS_DIR=~/n8n-shorts/secrets
