{
  "name": "Etymology Shorts — Daily",
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "nodes": [
    {
      "id": "trigger_manual",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [240, 300],
      "parameters": {}
    },
    {
      "id": "trigger_cron",
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 500],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 9 * * *"
            }
          ]
        }
      }
    },
    {
      "id": "get_next",
      "name": "Get next word",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, 400],
      "parameters": {
        "method": "GET",
        "url": "http://host.docker.internal:7860/state/next",
        "options": {
          "timeout": 10000
        }
      }
    },
    {
      "id": "if_pending",
      "name": "Has pending word?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [680, 400],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond_id_exists",
              "leftValue": "={{ $('Get next word').item.json?.id }}",
              "rightValue": "",
              "operator": {
                "type": "number",
                "operation": "exists",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "do_script",
      "name": "Generate script",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [900, 300],
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:7860/script",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={\"word_id\": {{ $('Get next word').item.json.id }}}",
        "options": {
          "timeout": 180000
        }
      }
    },
    {
      "id": "do_voice",
      "name": "Generate voice",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1120, 300],
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:7860/voice",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={\"word_id\": {{ $('Get next word').item.json.id }}}",
        "options": {
          "timeout": 60000
        }
      }
    },
    {
      "id": "do_image",
      "name": "Generate images",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1340, 300],
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:7860/image",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={\"word_id\": {{ $('Get next word').item.json.id }}}",
        "options": {
          "timeout": 7200000
        }
      }
    },
    {
      "id": "do_assemble",
      "name": "Assemble video",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1560, 300],
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:7860/assemble",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={\"word_id\": {{ $('Get next word').item.json.id }}}",
        "options": {
          "timeout": 120000
        }
      }
    },
    {
      "id": "do_upload",
      "name": "Upload to YouTube",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1780, 300],
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:7860/upload",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={\"word_id\": {{ $('Get next word').item.json.id }}, \"privacy\": \"private\"}",
        "options": {
          "timeout": 600000
        }
      }
    }
  ],
  "connections": {
    "Manual Trigger": {
      "main": [
        [
          {
            "node": "Get next word",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Schedule Trigger": {
      "main": [
        [
          {
            "node": "Get next word",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get next word": {
      "main": [
        [
          {
            "node": "Has pending word?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Has pending word?": {
      "main": [
        [
          {
            "node": "Generate script",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    },
    "Generate script": {
      "main": [
        [
          {
            "node": "Generate voice",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Generate voice": {
      "main": [
        [
          {
            "node": "Generate images",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Generate images": {
      "main": [
        [
          {
            "node": "Assemble video",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Assemble video": {
      "main": [
        [
          {
            "node": "Upload to YouTube",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
