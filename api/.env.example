# api/.env — runtime config for the FastAPI service (pydantic-settings).
# Copy to api/.env and edit. All keys are OPTIONAL; defaults live in config.py.
# Field names map case-insensitively to env keys (hf_token -> HF_TOKEN).
# NEVER commit api/.env (it is gitignored) — this .example file is the template.

# --- API server ---
# HOST=0.0.0.0
# PORT=7860

# --- Ollama (script LLM) ---
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=gemma4:latest
# OLLAMA_TIMEOUT_S=300

# --- Image backend ---
# Selects the per-image fallback chain (services/image.py):
#   "modal" = Modal GPU -> Space -> mflux   (PRODUCTION on stl; see modal_app/README.md)
#   "space" = Space -> mflux                 (code default; free hosted ZeroGPU)
#   "mflux" = local MLX only                 (Apple Silicon; offline/deterministic)
# In every chain mflux is the terminal tier, so a run always completes.
# IMAGE_BACKEND=space
# ZIMAGE_SPACE_URL=https://mrfakename-z-image-turbo.hf.space
# ZIMAGE_SPACE_TIMEOUT_S=180

# --- Modal image backend (when IMAGE_BACKEND=modal) ---
# Deployed endpoint base URL + shared bearer token. The token MUST match the
# `zimage-token` Modal Secret (key ZIMAGE_TOKEN). Set up via modal_app/README.md.
# Never commit real values.
# MODAL_IMAGE_URL=https://<workspace>--n8n-shorts-zimage-zimage-web.modal.run
# MODAL_IMAGE_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# MODAL_ATTEMPTS=2              # total tries before falling through to Space
# MODAL_RETRY_SLEEP_S=5.0      # sleep between Modal retries
# MODAL_TIMEOUT_S=120          # HTTP timeout (covers cold start)

# HF token for the hosted Space. Passed to gradio_client as token=, which bills
# ZeroGPU usage to YOUR account quota (free 5 min/day, PRO 40 min/day) instead
# of the anonymous per-IP pool (2 min/day). The raw REST API does NOT attribute
# to the account — use of gradio_client is required. ~10-15 s/image; mflux
# absorbs the tail once quota runs low. Get one at https://huggingface.co/settings/tokens
# HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- mflux (local image gen, Apple Silicon) ---
# MFLUX_MODEL=z-image-turbo
# MFLUX_QUANTIZE=8
# MFLUX_STEPS=8
# MFLUX_GUIDANCE=1.0
# MFLUX_SCHEDULER=flow_match_euler_discrete
# MFLUX_WIDTH=768
# MFLUX_HEIGHT=1344
# MFLUX_SEED_BASE=42
# MFLUX_CACHE_LIMIT_BYTES=1073741824

# --- Voice backend ---
# "piper" = local Piper TTS (default; license-traceable, monetization-safe).
# "kokoro" = Kokoro-FastAPI container (higher quality; PRODUCTION on stl). Any
# Kokoro failure falls back to local Piper per-clip, so a run always completes.
# VOICE_BACKEND=piper

# --- Piper TTS ---
# PIPER_LENGTH_SCALE=1.1
# PIPER_VOICES_DIR=~/n8n-shorts/assets/piper

# --- Kokoro TTS (when VOICE_BACKEND=kokoro) ---
# Container defined in repo-root docker-compose.yml (ghcr.io/remsky/kokoro-fastapi-cpu);
# bring it up with `docker compose up -d kokoro-tts` before flipping the flag.
# KOKORO_BASE_URL=http://localhost:8880
# KOKORO_MODEL=kokoro
# KOKORO_SPEED=1.0             # <1 slower; Kokoro's natural pacing needs no slowdown
# KOKORO_TIMEOUT_S=120
# Note: KOKORO_VOICES / PIPER_VOICES are lists — override via JSON if needed.

# --- Captions / outro ---
# CAPTION_LEAD_S=0.0
# OUTRO_PAUSE_S=0.25
# OUTRO_CTA=...   # empty string disables the spoken CTA and the outro card

# --- Storage / secrets (per-channel files live under these dirs) ---
# DATA_DIR=~/n8n-shorts/output
# DB_PATH=~/n8n-shorts/state.db
# SECRETS_DIR=~/n8n-shorts/secrets
